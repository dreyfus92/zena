// @mode: run
// @result: 42
class Point {
  x: i32;
  y: i32;

  new(this.x, this.y);

  new origin()
    : x = 0, y = 0;

  new fromX(x: i32)
    : x = x, y = 0;

  new fromXY(this.x, this.y);
}

export let main = (): i32 => {
  let p1 = new Point.origin();
  let p2 = new Point.fromX(10);
  let p3 = new Point.fromXY(2, 30);
  return p1.x + p1.y + p2.x + p2.y + p3.x + p3.y;
};

