// World-level exports with parameters richer than scalars and
// strings — lists, tuples, options, results, nested — and one whose
// parameters flatten past sixteen core values, which the canonical
// ABI spills into memory. Structural types only: a world-level
// function names no interface for a record or variant to live in.
package test:params@1.0.0;

world provider {
  export total: func(xs: list<u32>) -> u32;
  export window: func(w: tuple<u32, string>) -> string;
  export maybe-name: func(n: option<string>) -> string;
  export check: func(r: result<u32, string>) -> string;
  export labels: func(ps: list<tuple<u32, string>>) -> list<string>;
  export tally: async func(xs: list<u32>) -> u32;
  export many: func(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32,
      h: u32, i: u32, j: u32, k: u32, l: u32, m: u32, n: u32, o: u32,
      p: u32, q: string) -> string;
}
