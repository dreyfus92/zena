// The world `http-service.zena` is compiled against: the wasi:http
// service shape — the `handler` interface exported as an instance,
// its `handle` implemented by the program's exported async function,
// its `request`, `response` and `error-code` the types interface's,
// aliased out of the imported instance. The wasi:http and wasi:clocks
// packages are the stdlib's vendored WASI WIT, imported by name.
package test:http-service@1.0.0;

world http-service {
  import wasi:http/types@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;

  export wasi:http/handler@0.3.0;
}
