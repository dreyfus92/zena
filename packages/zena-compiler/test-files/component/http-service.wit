// The world `http-service.zena` is compiled against: the wasi:http
// service shape — the `handler` interface exported as an instance,
// its `handle` implemented by the program's exported async function,
// its `request`, `response` and `error-code` the types interface's,
// aliased out of the imported instance. The wasi:http package comes
// from the manifest's WIT-backed `wasi` package, not vendored here.
package test:http-service@1.0.0;

world http-service {
  import wasi:http/types@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;

  export wasi:http/handler@0.3.0;
}

// The clock the handler sleeps on, so that requests overlap: the
// compiler carries wasi:cli's WIT, and the manifest's wasi package
// carries http, but neither carries clocks.
package wasi:clocks@0.3.0 {
  interface monotonic-clock {
    type instant = u64;
    type duration = u64;

    now: func() -> instant;
    wait-for: async func(how-long: duration);
  }
}
