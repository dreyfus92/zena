import {suite, test, TestContext} from 'zena:test';
import {equal, isTrue, isFalse} from 'zena:assert';
import {URL, URLSearchParams} from 'zena:url';

// The Zena-specific API surface, which the generated WPT suite cannot cover:
// URL.parse's null return, canParse, toString, and derived components. Spec
// conformance of the parser itself lives in wpt_urltestdata_test.zena.

/** Parses input the test expects to be valid, failing the test if it isn't. */
let mustParse = (input: String, base: String | null = null): URL => {
  let u = URL.parse(input, base);
  isTrue(u != null);
  return u as URL;
};

export let tests = suite('URL API', (): void => {
  suite('parsing', (): void => {
    test('parses an absolute URL into its components', (ctx: TestContext): void => {
      let u = mustParse('https://example.com/a/b?q=1#f');
      equal(u.href, 'https://example.com/a/b?q=1#f');
      equal(u.protocol, 'https:');
      equal(u.hostname, 'example.com');
      equal(u.pathname, '/a/b');
      equal(u.search, '?q=1');
      equal(u.hash, '#f');
    });

    test('resolves against a base', (ctx: TestContext): void => {
      equal(mustParse('/x', 'https://example.com/a/b').href, 'https://example.com/x');
      equal(mustParse('y', 'https://example.com/a/b').href, 'https://example.com/a/y');
      equal(mustParse('../z', 'https://example.com/a/b/c').href, 'https://example.com/a/z');
      equal(mustParse('?q', 'https://example.com/a').href, 'https://example.com/a?q');
    });
  });

  suite('failure is a null return, not an exception', (): void => {
    // A string that does not parse is an ordinary outcome, so there is no
    // throwing constructor to test — URL.parse is the only way to build one.
    test('unparsable input returns null', (ctx: TestContext): void => {
      isTrue(URL.parse('not a url') == null);
      isTrue(URL.parse('http://f:b/c') == null);
      isTrue(URL.parse('') == null);
    });

    test('an unparsable base returns null', (ctx: TestContext): void => {
      isTrue(URL.parse('/x', 'not a base') == null);
    });

    test('a relative input with no base returns null', (ctx: TestContext): void => {
      isTrue(URL.parse('/just/a/path') == null);
    });

    test('canParse mirrors parse', (ctx: TestContext): void => {
      isTrue(URL.canParse('https://example.com/'));
      isTrue(URL.canParse('sub', 'https://example.com/dir/'));
      isFalse(URL.canParse('not a url'));
      isFalse(URL.canParse('http://f:b/c'));
      isFalse(URL.canParse('/x', 'not a base'));
    });
  });

  suite('derived components', (): void => {
    test('host includes the port only when present', (ctx: TestContext): void => {
      equal(mustParse('https://example.com/').host(), 'example.com');
      equal(mustParse('https://example.com:8080/').host(), 'example.com:8080');
      // A default port is dropped during parsing.
      let defaulted = mustParse('https://example.com:443/');
      equal(defaulted.host(), 'example.com');
      equal(defaulted.port, '');
    });

    test('origin is opaque for non-tuple schemes', (ctx: TestContext): void => {
      equal(mustParse('https://example.com:8080/a').origin(), 'https://example.com:8080');
      equal(mustParse('mailto:a@b.com').origin(), 'null');
      equal(mustParse('file:///tmp/x').origin(), 'null');
    });

    test('a blob URL takes the origin of the URL in its path', (ctx: TestContext): void => {
      equal(mustParse('blob:https://example.com:443/x').origin(), 'https://example.com');
      equal(mustParse('blob:http://example.org:88/x').origin(), 'http://example.org:88');
    });

    test('toString equals href', (ctx: TestContext): void => {
      let u = mustParse('https://example.com/a?b#c');
      equal(u.toString(), u.href);
    });
  });

  suite('normalization', (): void => {
    test('dot segments are resolved', (ctx: TestContext): void => {
      equal(mustParse('https://example.com/a/./b/../c').pathname, '/a/c');
    });

    test('the scheme and host are lowercased', (ctx: TestContext): void => {
      let u = mustParse('HTTPS://Example.COM/');
      equal(u.protocol, 'https:');
      equal(u.hostname, 'example.com');
    });

    test('IPv6 hosts keep their brackets and compress', (ctx: TestContext): void => {
      equal(mustParse('http://[2001:0db8:0000:0000:0000:0000:0000:0001]/').hostname,
            '[2001:db8::1]');
    });

    test('IPv4 hosts are canonicalized to dotted decimal', (ctx: TestContext): void => {
      equal(mustParse('http://0x7f.1/').hostname, '127.0.0.1');
    });
  });

  suite('IDNA is not implemented yet', (): void => {
    // Pinned so the behavior is an explicit failure rather than a silently
    // wrong host; update these when IDNA/UTS 46 support lands.
    test('a non-ASCII domain fails to parse rather than parsing wrongly', (ctx: TestContext): void => {
      isTrue(URL.parse('http://你好/') == null);
      isTrue(URL.parse('https://faß.example/') == null);
    });

    test('ASCII domains are unaffected', (ctx: TestContext): void => {
      equal(mustParse('http://xn--fsq.example/').hostname, 'xn--fsq.example');
    });
  });

  // Spec conformance of the setters themselves lives in wpt_setters_test.zena.
  // These cover what that suite cannot: that the receiver is untouched, and
  // that withHref/withSearchParams — which have no web setter equivalent to
  // port — behave.
  suite('with* methods', (): void => {
    test('the receiver is unchanged', (ctx: TestContext): void => {
      let u = mustParse('https://example.com/a?q=1#f');
      let changed = u.withPathname('/b').withHash('#g').withSearch('?r=2');
      equal(u.href, 'https://example.com/a?q=1#f');
      equal(changed.href, 'https://example.com/b?r=2#g');
    });

    test('a rejected value leaves the component alone', (ctx: TestContext): void => {
      // An empty scheme is not valid, so the URL comes back unchanged.
      let u = mustParse('https://example.com/');
      equal(u.withProtocol('').href, u.href);
      // Under a state override the port parser stops at the first non-digit
      // rather than erroring, so a wholly non-numeric port parses to nothing
      // and the old one survives.
      equal(mustParse('https://example.com:8080/').withPort('nope').port, '8080');
    });

    test('a partially applied change sticks, as on the web', (ctx: TestContext): void => {
      // The host takes effect, then the out-of-range port fails. The spec
      // parses in place and does not roll back, so the host change stands.
      let u = mustParse('http://example.net/path');
      let out = u.withHost('example.com:65536');
      equal(out.href, 'http://example.com/path');
      equal(out.port, '');
    });

    test('withSearchParams serializes the params into the query', (ctx: TestContext): void => {
      let p = new URLSearchParams('');
      p.append('q', 'a b');
      p.append('x', '1&2');
      equal(mustParse('https://example.com/').withSearchParams(p).href,
            'https://example.com/?q=a+b&x=1%262');
    });

    test('withSearchParams with no pairs drops the query entirely', (ctx: TestContext): void => {
      equal(mustParse('https://example.com/?q=1').withSearchParams(new URLSearchParams('')).href,
            'https://example.com/');
    });

    test('withHref reparses from scratch and returns null on failure', (ctx: TestContext): void => {
      let u = mustParse('https://example.com/a');
      let ok = u.withHref('http://other.example/b?c');
      isTrue(ok != null);
      equal((ok as URL).href, 'http://other.example/b?c');
      // Unlike the other with* methods, withHref has no old URL to fall back
      // on — every component is replaced — so failure is a null return.
      isTrue(u.withHref('not a url') == null);
    });

    test('withHost sets hostname and port together', (ctx: TestContext): void => {
      let u = mustParse('https://example.com/').withHost('other.example:8080');
      equal(u.hostname, 'other.example');
      equal(u.port, '8080');
      // withHostname leaves the port alone.
      equal(u.withHostname('third.example').port, '8080');
    });

    test('an IPv6 host round-trips through withHost and withHostname', (ctx: TestContext): void => {
      let u = mustParse('http://example.com/a').withHost('[2001:db8::1]:8080');
      equal(u.hostname, '[2001:db8::1]');
      equal(u.port, '8080');
      // The address is canonicalized on the way in, and the port survives a
      // hostname-only change.
      let v = u.withHostname('[0:0:0:0:0:0:0:1]');
      equal(v.hostname, '[::1]');
      equal(v.port, '8080');
      equal(v.href, 'http://[::1]:8080/a');
    });

    test('a malformed IPv6 address leaves the host alone', (ctx: TestContext): void => {
      let u = mustParse('http://example.com/a');
      equal(u.withHostname('[::1').hostname, 'example.com');
      equal(u.withHostname('[1:2:3:4:5:6:7:8:9]').hostname, 'example.com');
    });

    test('with* results are usable as HashMap keys', (ctx: TestContext): void => {
      isTrue(mustParse('https://example.com/a').withPathname('/b') ==
             mustParse('https://example.com/b'));
    });
  });

  suite('equality and hashing', (): void => {
    test('URLs parsed from the same text are equal', (ctx: TestContext): void => {
      isTrue(mustParse('https://example.com/a') == mustParse('https://example.com/a'));
    });

    test('equality is on the canonical form, not the input text', (ctx: TestContext): void => {
      // Both sides normalize to https://example.com/b during parsing.
      isTrue(mustParse('https://EXAMPLE.com:443/a/../b') == mustParse('https://example.com/b'));
    });

    test('differing URLs are not equal', (ctx: TestContext): void => {
      isFalse(mustParse('https://example.com/a') == mustParse('https://example.com/b'));
    });

    test('the fragment is part of the identity', (ctx: TestContext): void => {
      isFalse(mustParse('https://example.com/a#x') == mustParse('https://example.com/a'));
    });

    test('equal URLs hash equally — the Hashable contract', (ctx: TestContext): void => {
      let a = mustParse('https://EXAMPLE.com:443/a/../b');
      let b = mustParse('https://example.com/b');
      isTrue(a == b);
      equal(a.hashCode(), b.hashCode());
    });

    test('hashCode is stable across repeated calls', (ctx: TestContext): void => {
      let u = mustParse('https://example.com/a?q=1#f');
      equal(u.hashCode(), u.hashCode());
    });

    test('href is stable across repeated reads (it is cached)', (ctx: TestContext): void => {
      let u = mustParse('https://example.com/a/../b?q=1#f');
      equal(u.href, 'https://example.com/b?q=1#f');
      equal(u.href, u.href);
      equal(u.toString(), u.href);
    });

    test('works as a HashMap key, matching on canonical form', (ctx: TestContext): void => {
      let m = new HashMap<URL, String>();
      m[mustParse('https://example.com/a')] = 'first';
      // A different spelling of the same URL must hit the same entry.
      m[mustParse('https://EXAMPLE.com:443/a')] = 'second';
      equal(m.size, 1);
      equal(m[mustParse('https://example.com/a')], 'second');
    });

    test('distinct URLs occupy distinct HashMap entries', (ctx: TestContext): void => {
      let m = new HashMap<URL, String>();
      m[mustParse('https://example.com/a')] = 'a';
      m[mustParse('https://example.com/b')] = 'b';
      equal(m.size, 2);
      equal(m[mustParse('https://example.com/a')], 'a');
      equal(m[mustParse('https://example.com/b')], 'b');
    });
  });
});
