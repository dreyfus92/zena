/**
 * zena:core — the standard library's foundation: the types the language
 * itself is defined in terms of, and the utilities they are built from.
 *
 * Everything here is also importable under its own module name, and those
 * names are what the rest of the tree still uses. This entry point is what
 * lets an import site move over one area at a time; the old names are
 * retired once nothing imports them, which is Phase 3 of
 * docs/design/stdlib-organization.md.
 *
 * Re-exported by module name rather than by file, so `error-stack` keeps
 * the per-target entry its manifest gives it — the host hooks it names
 * trade in `anyref`, which a component cannot declare.
 *
 * Importing this loads all of it. Thirteen of these modules are in the
 * prelude already, so they are in every program's graph either way; the
 * rest are what an importer adds. See "What a facade costs" in the plan.
 */

// The language's own vocabulary: the types syntax lowers onto.
export * from './string.zena';
export * from './error.zena';
export * from 'zena:error-stack';
export * from './option.zena';
export * from './result.zena';
export * from './box.zena';
export * from './range.zena';
export * from './hashable.zena';
export * from './ownership.zena';
export * from './template-strings-array.zena';

// Iteration.
export * from './iterator.zena';
export * from './iterable-utils.zena';
export * from './array-iterator.zena';
export * from './growable-array-iterator.zena';

// The array types. Implemented here because `String.split` returns a
// `FixedArray<String>`, which would otherwise put `collections` below
// `string` and above `error` — a cycle. `collections` re-exports them,
// which is where a reader looks for them.
export * from './array.zena';
export * from './fixed-array.zena';
export * from './growable-array.zena';
export * from './immutable-array.zena';

// Bytes and string building.
export * from './byte-array.zena';
export * from './byte-buffer.zena';
export * from './string-builder.zena';
export * from './string-convert.zena';
export * from './string-reader.zena';
